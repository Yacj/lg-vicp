# ========================================
# 蓝格 VICP 后端一键部署专用配置（本地执行 pnpm deploy 使用）
# 复制本文件为 deploy/.env.deploy 并填写实际值
# 本文件已加入 .gitignore，不会随代码上传
# ========================================

# 服务器 IP 或域名（必填）
DEPLOY_SSH_HOST=
# 登录用户，默认 root
DEPLOY_SSH_USER=root
# SSH 端口，默认 22
DEPLOY_SSH_PORT=22
# 服务器上仓库目录，默认 /opt/lg-vicp
DEPLOY_REMOTE_DIR=/opt/lg-vicp