# ========================================
# 蓝格 VICP 后端一键部署专用配置（本地执行 pnpm deploy 使用）
# 复制本文件为 deploy/.env.deploy 并填写实际值
# 本文件已加入 .gitignore，不会随代码上传，也不会打进发布包
# ========================================

# 服务器 IP 或域名（必填）
DEPLOY_SSH_HOST=
# 登录用户，默认 root
DEPLOY_SSH_USER=root
# SSH 端口，默认 22
DEPLOY_SSH_PORT=22
# 服务器登录密码（与密钥二选一）
DEPLOY_SSH_PASSWORD=
# 私钥路径（填写则优先用密钥，可不填密码）
# DEPLOY_SSH_KEY=C:\Users\admin\.ssh\id_rsa

# 服务器上的后端目录（含 package.json 的那一层，不是 dist/）
# 必须与线上 PM2 的 cwd 一致，例如当前生产：/www/wwwroot/lgapi.zblack.cn
DEPLOY_REMOTE_DIR=/www/wwwroot/lgapi.zblack.cn

# PM2报告环境：日常只检查，首次缺依赖可用 pnpm run deploy --skip-db --install-report-runtime
DEPLOY_REPORT_RUNTIME_INSTALL=0
# 仅本次部署进程使用，不改全局包源；锁文件仍严格校验
DEPLOY_NPM_REGISTRY=https://registry.npmmirror.com
# 浏览器与附属下载可分别指定；默认均用国内playwright镜像（包含builds/cft/...目录）
# 不可直接填扁平chrome-for-testing镜像，否则当前CLI追加builds/cft后会404
DEPLOY_REPORT_CHROMIUM_DOWNLOAD_HOST=
DEPLOY_REPORT_DOWNLOAD_HOST=https://cdn.npmmirror.com/binaries/playwright
# 可选：服务器已准备的国内APT源列表绝对路径，仅本次安装使用，不覆盖/etc/apt
# DEPLOY_REPORT_APT_SOURCE_FILE=/opt/lg-runtime/debian.sources.list
