# ========================================
# 运行环境与服务监听
# ========================================
# 运行环境：development、test 或 production
NODE_ENV=development
# 服务监听地址和端口
HOST=0.0.0.0
PORT=3000
# 允许访问 API 的前端来源；生产环境请改为实际域名
CORS_ORIGIN=

# ========================================
# PostgreSQL 数据库
# ========================================
# 数据库连接地址（必填）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lg_vicp_backend
# 数据库连接池和连接超时时间
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
# Docker Compose 的 PostgreSQL 密码（敏感信息）
POSTGRES_PASSWORD=postgres

# ========================================
# Redis
# ========================================
# Redis 连接地址（必填）
REDIS_URL=redis://localhost:6379

# ========================================
# JWT 与登录安全
# ========================================
# JWT 签名密钥（敏感信息，生产环境必须替换为随机长密钥）
JWT_SECRET=change-this-jwt-secret-before-use-123456
# 各客户端访问令牌有效期
JWT_B_ACCESS_EXPIRES_IN=24h
JWT_C_ACCESS_EXPIRES_IN=30d
JWT_PC_AI_ACCESS_EXPIRES_IN=30d
# 刷新令牌统一有效天数
REFRESH_TOKEN_TTL_DAYS=30

# ========================================
# AI 调用限制与密钥加密
# ========================================
# 单个用户每分钟最多发起的 AI 请求数
AI_RATE_LIMIT_PER_MINUTE=20
# AI 配置密钥的 AES-256-GCM 加密主密钥（必须恰好 32 字节，敏感信息）
AI_CONFIG_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ========================================
# 对象存储通用配置
# ========================================
# 存储提供商：开发环境使用 minio，生产环境可切换为 oss
STORAGE_PROVIDER=minio
STORAGE_BUCKET=lg-vicp
# 预签名地址有效期（秒）和单文件最大上传大小（字节）
STORAGE_PRESIGN_EXPIRES_SECONDS=900
MAX_UPLOAD_BYTES=52428800

# ========================================
# MinIO 开发环境配置
# ========================================
# MinIO 服务端连接配置
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
# 返回给浏览器的 MinIO 访问地址配置
STORAGE_PUBLIC_ENDPOINT=localhost
STORAGE_PUBLIC_PORT=9000
STORAGE_PUBLIC_USE_SSL=false
# MinIO 访问凭证（敏感信息；默认值仅用于本地开发）
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ========================================
# 阿里云 OSS 生产环境配置
# ========================================
# 使用 OSS 时请将 STORAGE_PROVIDER 改为 oss
OSS_REGION=oss-cn-hangzhou
OSS_ENDPOINT=
OSS_INTERNAL=false
# OSS 使用上面的 STORAGE_ACCESS_KEY、STORAGE_SECRET_KEY 和 STORAGE_BUCKET

# ========================================
# 报告导出
# ========================================
# Playwright/Chromium 可执行文件路径；Docker 环境通常为 /usr/bin/chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# ========================================
# 初始化管理员
# ========================================
# 首次执行 seed 时使用；管理员密码至少 5 位（敏感信息）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=请替换为至少5位的管理员密码

# ========================================
# 一键部署（本地 pnpm deploy 使用，SSH 密钥免密登录）
# ========================================
# 服务器 IP 或域名（必填）；以下仅本地需要，不会上传到服务器
DEPLOY_SSH_HOST=
# 登录用户，默认 root；SSH 端口，默认 22
DEPLOY_SSH_USER=root
DEPLOY_SSH_PORT=22
# 服务器上仓库目录，默认 /opt/lg-vicp
DEPLOY_REMOTE_DIR=/opt/lg-vicp
