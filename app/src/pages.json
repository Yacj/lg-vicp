{
  "globalStyle": {
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTextStyle": "@navTxtStyle",
    "navigationBarTitleText": "筑小格 AI 助手",
    "backgroundColor": "@bgColor",
    "backgroundTextStyle": "@bgTxtStyle",
    "backgroundColorTop": "@bgColorTop",
    "backgroundColorBottom": "@bgColorBottom",
    "enablePullDownRefresh": false,
    "onReachBottomDistance": 50,
    "animationType": "pop-in",
    "animationDuration": 300
  },
  "easycom": {
    "custom": {
      "^(?!z-paging-refresh|z-paging-load-more)z-paging(.*)": "z-paging/components/z-paging$1/z-paging$1.vue"
    }
  },
  "pages": [
    // #ifdef APP || H5 || MP-WEIXIN
    {
      "path": "pages/index/index",
      "type": "home",
      "name": "home",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "custom"
      }
    },
    // #endif
    {
      "path": "pages/login",
      "type": "page",
      "name": "login",
      "layout": "default",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/about/index",
      "type": "page",
      "name": "about",
      "layout": "tabbar",
      "style": {
        "navigationBarTitleText": "关于"
      }
    },
    {
      "path": "pages/appearance-settings/index",
      "type": "page",
      "name": "appearance-settings",
      "layout": "default",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "外观设置"
      }
    },
    {
      "path": "pages/assistant/index",
      "type": "page",
      "name": "assistant",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "custom",
        "app-plus": {
          "softinputMode": "adjustResize"
        }
      }
    },
    {
      "path": "pages/conversation-history/index",
      "type": "page",
      "name": "conversation-history",
      "layout": "default",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/profile/index",
      "type": "page",
      "name": "profile",
      "layout": "tabbar",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/profile-info/index",
      "type": "page",
      "name": "profile-info",
      "layout": "default",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "个人信息"
      }
    },
    {
      "path": "pages/project-create/index",
      "type": "page",
      "name": "project-create",
      "layout": "default",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/project-detail/index",
      "type": "page",
      "name": "project-detail",
      "layout": "default",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/project-edit/index",
      "type": "page",
      "name": "project-edit",
      "layout": "default",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/project-files/index",
      "type": "page",
      "name": "project-files",
      "layout": "default",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/projects/index",
      "type": "page"
    },
    {
      "path": "pages/share/index",
      "type": "page",
      "name": "share",
      "layout": "default",
      "style": {
        "navigationStyle": "custom"
      }
    }
  ],
  "subPackages": [],
  "tabBar": {
    "custom": true,
    "customize": true,
    "overlay": true,
    "height": "0",
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      // GENERATED BY UNI-PAGES, PLATFORM: APP || H5 || MP-WEIXIN
      {
        "pagePath": "pages/index/index"
      },
      {
        "pagePath": "pages/projects/index"
      },
      {
        "pagePath": "pages/assistant/index"
      },
      {
        "pagePath": "pages/profile/index"
      }
    ]
  }
}